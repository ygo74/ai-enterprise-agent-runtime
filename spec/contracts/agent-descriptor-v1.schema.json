{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygo74.dev/schemas/agent-descriptor-v1.schema.json",
  "title": "Agent Descriptor v1",
  "description": "Provider-neutral canonical description of one exposed agent. Single source of truth projected into the OpenAI model listing, the Anthropic model listing, and the A2A agent card.",
  "type": "object",
  "required": [
    "agentId",
    "routeKey",
    "displayName",
    "description",
    "version",
    "owner",
    "createdAtUtc",
    "capabilities"
  ],
  "properties": {
    "agentId": {
      "type": "string",
      "description": "Public identifier advertised as the model identifier and accepted verbatim as an invocation model value.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "routeKey": {
      "type": "string",
      "description": "Dispatch route key this descriptor is bound to. Must resolve to a registered handler.",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "description": "Owner or provider label surfaced as OpenAI ownership and as the A2A provider.",
      "minLength": 1
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "documentationUrl": {
      "type": "string",
      "format": "uri"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "capabilities": { "$ref": "#/$defs/agentCapabilitySet" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/agentSkill" },
      "default": []
    },
    "securitySchemes": {
      "type": "array",
      "description": "Names of authentication schemes the runtime enforces for this agent. Never contains secret material.",
      "items": { "type": "string" },
      "default": []
    },
    "discoveryVisibility": {
      "type": "string",
      "enum": ["listed", "hidden"],
      "default": "listed"
    },
    "metadata": {
      "type": "object",
      "description": "Free-form additional metadata carried through to discovery surfaces without runtime interpretation.",
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agentCapabilitySet": {
      "type": "object",
      "required": ["streaming", "inputModalities", "outputModalities"],
      "properties": {
        "streaming": {
          "type": "boolean",
          "default": false,
          "description": "Must not contradict the streaming configuration of the bound route."
        },
        "inputModalities": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "default": ["text"]
        },
        "outputModalities": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "default": ["text"]
        },
        "toolInvocation": { "type": "boolean", "default": false },
        "structuredOutput": { "type": "boolean", "default": false },
        "sizeUnit": {
          "type": "string",
          "enum": ["tokens", "characters", "bytes"],
          "default": "tokens",
          "description": "Unit in which maxInputSize and maxOutputSize are expressed. Applies to both values. Required whenever either size is declared."
        },
        "maxInputSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum accepted input size, expressed in sizeUnit."
        },
        "maxOutputSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum produced output size, expressed in sizeUnit."
        },
        "extensions": {
          "type": "object",
          "description": "Additional capability facts projected into the provider additive extension section.",
          "additionalProperties": true,
          "default": {}
        }
      },
      "dependentRequired": {
        "maxInputSize": ["sizeUnit"],
        "maxOutputSize": ["sizeUnit"]
      },
      "additionalProperties": false
    },
    "agentSkill": {
      "type": "object",
      "required": ["skillId", "name", "description"],
      "properties": {
        "skillId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "inputModalities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputModalities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
