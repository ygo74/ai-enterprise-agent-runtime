        "--reload-dir",
        "${workspaceFolder}/packages/python",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder}/docs/examples/python-langchain-fastapi/03-jwt-oidc-keycloak",
      "envFile": "${workspaceFolder}/docs/examples/python-langchain-fastapi/03-jwt-oidc-keycloak/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/packages/python"
      },
      "subProcess": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: 04-Human in the Loop API (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
