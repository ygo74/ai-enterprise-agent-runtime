{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug structured Responses API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "responses_structured_app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8100"
      ],
      "cwd": "${workspaceFolder:ai-enterprise-agent-runtime}/docs/examples/python-fastapi-quickstart",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: 01-get-started API (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder:ai-enterprise-agent-runtime}/venv/agent_client_demo/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "openai_responses_app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder:ai-enterprise-agent-runtime}/docs/examples/python-langchain-fastapi/01-get-started",
      "envFile": "${workspaceFolder:ai-enterprise-agent-runtime}/docs/examples/python-langchain-fastapi/01-get-started/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder:ai-enterprise-agent-runtime}/packages/python/security;${workspaceFolder:ai-enterprise-agent-runtime}/packages/python/agents"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: 02-JWT Authentication API (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/agent_client_demo/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "openai_responses_jwt_app:app",
        "--reload",
        "--reload-dir",
        "${workspaceFolder}/docs/examples/python-langchain-fastapi/02-jwt-authentication",
        "--reload-dir",
        "${workspaceFolder}/packages/python",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder}/docs/examples/python-langchain-fastapi/02-jwt-authentication",
      "envFile": "${workspaceFolder}/docs/examples/python-langchain-fastapi/02-jwt-authentication/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/packages/python"
      },
      "subProcess": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: 03-JWT OIDC Keycloak API (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/agent_client_demo/Scripts/python.exe",
      "module": "uvicorn",
