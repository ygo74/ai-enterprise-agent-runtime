{
  "$defs": {
    "McpApiKeyInput": {
      "additionalProperties": false,
      "description": "YAML fields for a single API-key header.\n\nArgs:\n    header_name (_ConfigurationText): HTTP header receiving the resolved key.\n    value (_SecretReference): Environment reference containing the key.",
      "properties": {
        "header_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Header Name",
          "type": "string"
        },
        "value": {
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "header_name",
        "value"
      ],
      "title": "McpApiKeyInput",
      "type": "object"
    },
    "McpAuthenticationMode": {
      "description": "Authentication method selected for an HTTP MCP server.",
      "enum": [
        "none",
        "api_key",
        "oauth",
        "oauth_on_behalf_of"
      ],
      "title": "McpAuthenticationMode",
      "type": "string"
    },
    "McpDelegatedOAuthInput": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "token_url"
                ]
              },
              {
                "required": [
                  "client_id"
                ]
              },
              {
                "required": [
                  "client_secret"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "token_url",
              "client_id",
              "client_secret"
            ]
          }
        }
      ],
      "description": "YAML settings for OAuth on-behalf-of exchange.\n\nArgs:\n    token_url (_ConfigurationText | None): HTTPS token endpoint for the runtime source or a custom factory.\n    client_id (_ConfigurationText | None): OAuth client identity for the exchange source.\n    client_secret (_SecretReference | None): Environment reference for the OAuth client credential.\n    audience (_ConfigurationText): Downstream MCP resource identifier.\n    scopes (tuple[_ConfigurationText, ...]): Optional scopes requested from the delegated-token source.",
      "properties": {
        "token_url": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "^https://\\S+$",
          "title": "Token Url"
        },
        "client_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        },
        "client_secret": {
          "anyOf": [
            {
              "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret"
        },
        "audience": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Audience",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "audience"
      ],
      "title": "McpDelegatedOAuthInput",
      "type": "object"
    },
    "McpNetworkInput": {
      "additionalProperties": false,
      "description": "Optional network settings for a streamable HTTP connection.\n\nArgs:\n    proxy_url (_ConfigurationText | None): Optional credential-free HTTP or HTTPS proxy URL.",
      "properties": {
        "proxy_url": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Url"
        }
      },
      "title": "McpNetworkInput",
      "type": "object"
    },
    "McpOAuthInput": {
      "additionalProperties": false,
      "description": "YAML fields for an OAuth client using the runtime's loopback flow.\n\nArgs:\n    client_id (_ConfigurationText): Pre-registered OAuth client identity.\n    client_secret (_SecretReference): Environment reference containing the client secret.\n    callback_port (StrictInt): Local loopback port used for the authorization redirect.\n    scopes (tuple[_ConfigurationText, ...]): Requested scopes pinned by the runtime.\n    token_file (_ConfigurationText): Token storage path, relative to the delivered root by default.\n    client_name (_ConfigurationText): Human-readable OAuth client label.",
      "properties": {
        "client_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Client Id",
          "type": "string"
        },
        "client_secret": {
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$",
          "title": "Client Secret",
          "type": "string"
        },
        "callback_port": {
          "default": 8765,
          "maximum": 65535,
          "minimum": 1,
          "title": "Callback Port",
          "type": "integer"
        },
        "scopes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "token_file": {
          "default": ".secrets/mcp-token.json",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Token File",
          "type": "string"
        },
        "client_name": {
          "default": "MCP client",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Client Name",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "client_secret",
        "scopes"
      ],
      "title": "McpOAuthInput",
      "type": "object"
    },
    "McpTransport": {
      "description": "How a client reaches a server.",
      "enum": [
        "stdio",
        "http"
      ],
      "title": "McpTransport",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "http"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "stdio"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authentication_mode": {
            "const": "api_key"
          }
        },
        "required": [
          "authentication_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "authentication_oauth"
          ]
        },
        "required": [
          "authentication_api_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authentication_mode": {
            "const": "oauth"
          }
        },
        "required": [
          "authentication_mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "authentication_api_key"
          ]
        },
        "required": [
          "authentication_oauth"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "authentication_mode": {
            "const": "oauth_on_behalf_of"
          }
        },
        "required": [
          "authentication_mode"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "authentication_api_key"
              ]
            },
            {
              "required": [
                "authentication_oauth"
              ]
            }
          ]
        },
        "required": [
          "authentication_oauth_on_behalf_of"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "authentication_mode"
              ]
            }
          },
          {
            "properties": {
              "authentication_mode": {
                "const": "none"
              }
            }
          }
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "authentication_api_key"
              ]
            },
            {
              "required": [
                "authentication_oauth"
              ]
            },
            {
              "required": [
                "authentication_oauth_on_behalf_of"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "stdio"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "authentication_mode": {
                  "enum": [
                    "api_key",
                    "oauth",
                    "oauth_on_behalf_of"
                  ]
                }
              },
              "required": [
                "authentication_mode"
              ]
            },
            {
              "properties": {
                "network": {
                  "properties": {
                    "proxy_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "proxy_url"
                  ]
                }
              },
              "required": [
                "network"
              ]
            },
            {
              "properties": {
                "headers": {
                  "minProperties": 1
                }
              },
              "required": [
                "headers"
              ]
            }
          ]
        }
      }
    }
  ],
  "description": "Strict typed representation of one MCP server YAML file.\n\nArgs:\n    server (_ConfigurationText | None): Optional server identity, defaulting to the file name.\n    transport (McpTransport): HTTP or stdio transport selected for the server.\n    url (_ConfigurationText | None): HTTP endpoint when using HTTP transport.\n    command (_ConfigurationText | None): Executable when using stdio transport.\n    args (tuple[StrictStr, ...]): Arguments passed to a stdio executable.\n    env (dict[StrictStr, StrictStr]): Additional environment passed to a stdio executable.\n    capabilities (tuple[_ConfigurationText, ...]): Application capabilities declared by the server.\n    tools (dict[_ConfigurationText, _ConfigurationText]): Logical aliases and remote tool names.\n    dialect (_ConfigurationText): Protocol dialect selected by the application.\n    read_only_variable (_ConfigurationText | None): Deployment variable interpreted by the host.\n    request_timeout_seconds (StrictInt): HTTP request and protocol session timeout.\n    headers (dict[StrictStr, StrictStr]): HTTP headers containing literals, env references, or context tokens.\n    authentication_mode (McpAuthenticationMode): Selected HTTP authentication mechanism.\n    authentication_api_key (McpApiKeyInput | None): API-key header settings when selected.\n    authentication_oauth (McpOAuthInput | None): OAuth client settings when selected.\n    authentication_oauth_on_behalf_of (McpDelegatedOAuthInput | None): Audience and scopes for delegated OAuth.\n    network (McpNetworkInput): HTTP proxy options.",
  "properties": {
    "server": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Server"
    },
    "transport": {
      "$ref": "#/$defs/McpTransport"
    },
    "url": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "command": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "args": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Args",
      "type": "array"
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Env",
      "type": "object"
    },
    "capabilities": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "tools": {
      "patternProperties": {
        "\\S": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Tools",
      "type": "object"
    },
    "dialect": {
      "default": "native",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Dialect",
      "type": "string"
    },
    "read_only_variable": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Read Only Variable"
    },
    "request_timeout_seconds": {
      "default": 30,
      "minimum": 1,
      "title": "Request Timeout Seconds",
      "type": "integer"
    },
    "headers": {
      "additionalProperties": {
        "pattern": "^(?:\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}|(?:(?!\\$\\{|\\{\\{|\\}\\}|\\r|\\n)[\\s\\S]|\\{\\{(?:USER_ID|USER_EMAIL|USER_NAME|USER_ROLES|REQUEST_ID|CONVERSATION_ID|SESSION_ID)\\}\\})*)$",
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
      },
      "type": "object"
    },
    "authentication_mode": {
      "$ref": "#/$defs/McpAuthenticationMode",
      "default": "none"
    },
    "authentication_api_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpApiKeyInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authentication_oauth": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpOAuthInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authentication_oauth_on_behalf_of": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpDelegatedOAuthInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "network": {
      "$ref": "#/$defs/McpNetworkInput"
    }
  },
  "required": [
    "transport",
    "capabilities"
  ],
  "title": "McpServerConfigurationInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ygo74:agent-runtime:mcp-server-configuration:1"
}
