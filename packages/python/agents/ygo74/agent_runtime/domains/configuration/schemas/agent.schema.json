{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ygo74:agent-runtime:agent-manifest:1",
  "additionalProperties": false,
  "description": "The fixed YAML fields accepted for one agent.",
  "properties": {
    "name": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "skills": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Skills",
      "type": "array"
    }
  },
  "required": [
    "name",
    "description",
    "skills"
  ],
  "title": "AgentManifestInput",
  "type": "object"
}
